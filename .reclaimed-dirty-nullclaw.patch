+fn runAntigravityChat(allocator: std.mem.Allocator, prompt: []const u8) ![]const u8 {
+    const argv = [_][]const u8{
+        GeminiCliProvider.CLI_NAME,
+        "chat",
+        "--mode=agent",
+        prompt,
+    };
+
+    var child = std_compat.process.Child.init(&argv, allocator);
+    child.stdin_behavior = .Close;
+    child.stdout_behavior = .Pipe;
+    child.stderr_behavior = .Ignore;
+
+    child.spawn() catch return error.CliNotFound;
+    const out = child.stdout.?.readToEndAlloc(allocator, GeminiCliProvider.MAX_OUTPUT_BYTES) catch |err| {
+        _ = child.wait() catch {};
+        return err;
+    };
+    errdefer allocator.free(out);
+
+    const term = child.wait() catch return error.CliProcessFailed;
+    switch (term) {
+        .exited => |code| {
+            if (code != 0) return error.CliProcessFailed;
+        },
+        else => return error.CliProcessFailed,
+    }
+
+    const trimmed = std.mem.trimEnd(u8, out, " \t\r\n");
+    if (trimmed.len == 0) return error.NoResultInOutput;
+    if (trimmed.len == out.len) return out;
+
+    const result = try allocator.dupe(u8, trimmed);
+    allocator.free(out);
+    return result;
+}
